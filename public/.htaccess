# Bari Porichalona — React SPA on Apache / cPanel
#
# Vite copies everything in public/ into dist/, so this ships with every build.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS. The auth refresh cookie is marked `secure` in production, so on
  # plain HTTP the browser silently drops it and users are logged out whenever
  # their access token expires.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Client-side routing: anything that is not a real file or directory is handed
  # to index.html so React Router can resolve it. Without this, opening
  # /dashboard directly — which is exactly what the installed PWA does, since
  # start_url points there — returns a 404 from Apache.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ─── Caching ─────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Hashed asset filenames change on every build, so they can be cached hard.
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # These three must never be cached, or users stay pinned to an old release:
  # index.html carries the asset hashes, and the service worker + manifest are
  # how an update reaches an already-installed PWA.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # The service worker must be allowed to control the whole origin.
  <FilesMatch "sw\.js$">
    Header set Service-Worker-Allowed "/"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
